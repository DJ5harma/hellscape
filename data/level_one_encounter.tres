[sub_resource type="Resource" id="Spawn_ranged"]
script = ExtResource("2_spawn")
enemy_name = "Level1Ranged"
archetype = "ranged"
spawn_position = Vector3(8, 1.1, -35)

[resource]
script = ExtResource("1_encounter")
