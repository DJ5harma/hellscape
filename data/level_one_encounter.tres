[gd_resource type="Resource" script_class="EncounterData" load_steps=4 format=3]

[ext_resource type="Script" path="res://data/encounter_data.gd" id="1_encounter"]
[ext_resource type="Script" path="res://data/enemy_spawn_data.gd" id="2_spawn"]

[sub_resource type="Resource" id="Spawn_melee"]
script = ExtResource("2_spawn")
enemy_name = "Level1Melee"
