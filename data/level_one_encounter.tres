[gd_resource type="Resource" script_class="EncounterData" load_steps=7 format=3]

[ext_resource type="Script" path="res://data/encounter_data.gd" id="1_encounter"]
[ext_resource type="Script" path="res://data/enemy_spawn_data.gd" id="2_spawn"]
[ext_resource type="Script" path="res://data/encounter_wave_data.gd" id="3_wave"]

[sub_resource type="Resource" id="Spawn_melee"]
script = ExtResource("2_spawn")
enemy_name = "Level1Melee"
archetype = "melee"
spawn_position = Vector3(0, 1.1, -31)

[sub_resource type="Resource" id="Spawn_ranged"]
script = ExtResource("2_spawn")
enemy_name = "Level1Ranged"
archetype = "ranged"
spawn_position = Vector3(8, 1.1, -35)

[sub_resource type="Resource" id="Spawn_melee_b"]
script = ExtResource("2_spawn")
enemy_name = "Level1MeleeB"
archetype = "melee"
spawn_mode = "ambush"
spawn_position = Vector3(4, 1.1, -36)

[sub_resource type="Resource" id="Spawn_ranged_b"]
script = ExtResource("2_spawn")
enemy_name = "Level1RangedB"
archetype = "ranged"
spawn_position = Vector3(-8, 1.1, -34)

[sub_resource type="Resource" id="Wave_one"]
script = ExtResource("3_wave")
display_name = "WAVE 1"
enemy_spawns = Array[Resource]([
	SubResource("Spawn_melee"),
	SubResource("Spawn_ranged"),
	SubResource("Spawn_melee_b"),
	SubResource("Spawn_ranged_b")
])

[resource]
script = ExtResource("1_encounter")
display_name = "LEVEL 1 ENCOUNTER"
objective = "DEFEAT ALL HOSTILES"
waves = Array[Resource]([SubResource("Wave_one")])
